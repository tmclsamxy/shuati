# =========================================================
# 刷题记忆 · 环境变量示例
# ---------------------------------------------------------
# 复制为 .env 后按需修改；docker-compose 会自动读取。
# 若用 systemd 直接跑 Node 进程，则把下面几项写进
# /etc/systemd/system/quiz-memory.service 的 Environment= 。
# =========================================================

# 监听端口（容器内固定 3000，改这里需同步改 compose 端口映射）
PORT=3000

# SQLite 数据库文件路径
#   容器内：/app/server/data/quiz.sqlite
#   宿主机直跑：./server/data/quiz.sqlite
DB_PATH=/app/server/data/quiz.sqlite

# 前端静态文件目录
#   容器内前端挂在 /app/web
#   宿主机直跑用 ../（即项目根目录）
STATIC_DIR=/app/web

# 登录会话有效期（天）。默认 30 天
SESSION_DAYS=30

# 时区
TZ=Asia/Shanghai
